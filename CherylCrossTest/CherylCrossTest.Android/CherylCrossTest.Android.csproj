<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Avalonia 12 on Android requires .NET 10. -->
        <TargetFramework>net10.0-android36.0</TargetFramework>
        <Nullable>enable</Nullable>
        <!-- androidx.lifecycle (pulled in by Avalonia 12 on Android) requires API 23+. -->
        <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
        <ApplicationId>com.CompanyName.CherylCrossTest</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\Icon.png</Link>
        </AndroidResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CherylCrossTest\CherylCrossTest.csproj" />
    </ItemGroup>
</Project>
