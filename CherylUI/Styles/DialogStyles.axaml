<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:CherylUI.Controls"
    xmlns:glassMorphism="clr-namespace:CherylUI.Controls.GlassMorphism"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dialog styling, aligned with SukiUI's SukiDialog / SukiDialogHost:
        rounded 25 glass card, centered 22px title, 14px content, right aligned action buttons,
        optional colored icon bubble on top and a 0.4 backdrop that fades in.
    -->

    <ControlTheme
        TargetType="controls:CherylDialog"
        x:Key="CherylDialogTheme">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border
                        Background="{DynamicResource DialogBackground}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1"
                        BoxShadow="0 18 45 0 #45000000"
                        ClipToBounds="True"
                        CornerRadius="25"
                        Margin="0,55,0,0"
                        MinWidth="360"
                        Name="PART_CardRoot">
                        <Panel>
                            <glassMorphism:GlassCard
                                ClipToBounds="True"
                                CornerRadius="25"
                                IsHitTestVisible="False"
                                IsVisible="{TemplateBinding ShowCardBackground}"
                                Padding="0" />

                            <Grid
                                ColumnDefinitions="*"
                                Margin="30,5,30,5"
                                Name="PART_DialogGrid"
                                RowDefinitions="Auto,Auto,Auto,Auto">
                                <!--  Extra top room when the icon bubble is shown  -->
                                <Border
                                    Grid.Row="0"
                                    Margin="0,10,0,0"
                                    IsVisible="{TemplateBinding IconColor, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                <TextBlock
                                    Grid.Row="1"
                                    FontSize="22"
                                    FontWeight="DemiBold"
                                    HorizontalAlignment="Center"
                                    Margin="0,24,0,0"
                                    IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Text="{TemplateBinding Title}" />

                                <ContentControl
                                    Grid.Row="2"
                                    Content="{TemplateBinding Content}"
                                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Margin="0,20,0,0">
                                    <ContentControl.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentControl.Styles>
                                </ContentControl>

                                <ItemsControl
                                    Grid.Row="3"
                                    HorizontalAlignment="Right"
                                    ItemsSource="{TemplateBinding ActionButtons}"
                                    Margin="0,26,0,21">
                                    <ItemsControl.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Margin" Value="12,0,0,0" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>

                            <ContentControl
                                Content="{TemplateBinding ViewModel}"
                                IsVisible="{TemplateBinding IsViewModelOnly}"
                                Margin="15" />
                        </Panel>
                    </Border>

                    <!--  Message box style icon bubble, overlapping the top of the card  -->
                    <Border
                        CornerRadius="50"
                        Height="100"
                        HorizontalAlignment="Center"
                        IsVisible="{TemplateBinding IconColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Margin="0,-15,0,0"
                        VerticalAlignment="Top"
                        Width="100">
                        <Panel>
                            <Ellipse
                                Fill="{TemplateBinding IconColor}"
                                Height="100"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="100" />
                            <PathIcon
                                Data="{TemplateBinding Icon}"
                                Foreground="White"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="28" />
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!--  The ViewModel-only mode replaces the Title/Content/Buttons layout  -->
        <Style Selector="^[IsViewModelOnly=True] /template/ Grid#PART_DialogGrid">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!--  Slide to the bottom of the host (CherylUI extra)  -->
        <Style Selector="^[ShowAtBottom=True]">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource CherylDialogTheme}"
        TargetType="controls:CherylDialog"
        x:Key="{x:Type controls:CherylDialog}" />

    <ControlTheme
        TargetType="controls:CherylDialogHost"
        x:Key="CherylDialogHostTheme">
        <!--  Nothing is interactive while closed, so the overlay never eats clicks  -->
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border
                        Background="{DynamicResource GridDialogBackground}"
                        IsHitTestVisible="False"
                        Name="PART_DialogBackground"
                        Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Duration="0:0:0.25" Property="Opacity" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <ContentControl
                        Content="{TemplateBinding Dialog}"
                        HorizontalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Name="PART_DialogContent"
                        Opacity="0"
                        RenderTransform="scale(0.85)"
                        VerticalAlignment="Stretch">
                        <ContentControl.Transitions>
                            <Transitions>
                                <DoubleTransition Duration="0:0:0.2" Property="Opacity" />
                                <TransformOperationsTransition Duration="0:0:0.3" Property="RenderTransform">
                                    <TransformOperationsTransition.Easing>
                                        <CircularEaseOut />
                                    </TransformOperationsTransition.Easing>
                                </TransformOperationsTransition>
                            </Transitions>
                        </ContentControl.Transitions>
                    </ContentControl>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsDialogOpen=True]">
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="^[IsDialogOpen=True] /template/ Border#PART_DialogBackground">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="^[IsDialogOpen=True] /template/ ContentControl#PART_DialogContent">
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource CherylDialogHostTheme}"
        TargetType="controls:CherylDialogHost"
        x:Key="{x:Type controls:CherylDialogHost}" />

</ResourceDictionary>
